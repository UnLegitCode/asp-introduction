@page
@model asp_lesson_introduction.Pages.ContactModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Обратная связь";
}

<h1>Обратная связь</h1>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div>@Model.Message</div>
}

<form method="post">
    <div>
        <label asp-for="Form.Name">Имя: </label>
        <input asp-for="Form.Name" type="text" />
    </div>
    
    <div>
        <label asp-for="Form.Email">Email: </label>
        <input asp-for="Form.Email" type="text" />
    </div>
    
    <div>
        <label asp-for="Form.Text">Сообщение: </label>
        <textarea asp-for="Form.Text" type="text" rows="4"></textarea>
    </div>
    
    <div>
        <button type="submit">Отправить</button>
    </div>
</form>